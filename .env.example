# Template only. Copy to an ignored .env and provide your own local values.
APP_ENV=local
DB_HOST=mysql
DB_PORT=3306
DB_NAME=telecom
DB_USER=telecom_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
LOG_LEVEL=INFO
LOG_FORMAT=json
INCIDENT_API_BASE_URL=http://internal-proxy:18081
EVENT_RELAY_BASE_URL=http://event-relay:18090
N8N_WEBHOOK_URL=http://n8n:5678/webhook/incident-v1
INCIDENT_API_TOKEN=
EVENT_INGEST_TOKEN=
DISCORD_WEBHOOK_URL=
N8N_ENCRYPTION_KEY=
# Lab: DB_HOST=192.168.30.100 and APP_ENV=lab.
# Lab internal URLs use host loopback; see docs/contracts/environment-variables.md.

# ---- 개인 포트폴리오에서 추가 (김준식) ----
# 앱이 실제로 읽지만 팀 템플릿에 빠져 있던 값들. 비워 두면 해당 기능만 꺼진다.
# n8n → /api/internal/ip-blocks·account-locks 전용 (비우면 INCIDENT_API_TOKEN 사용)
AUTOMATION_API_TOKEN=
# 쉼표 구분. 여기 없는 관리자는 권한 점검에서 '위반'
ADMIN_ALLOWLIST=admin@test.local
# 로컬 관제 스택을 띄웠다면 graylog
GRAYLOG_GELF_HOST=
GRAYLOG_GELF_PORT=12201
IP_BLOCK_DEFAULT_MINUTES=60
# none = 앱 차단 목록만, pfSense 연동은 n8n 이 담당
FIREWALL_PROVIDER=none
# 카카오페이 테스트 키(DEV_…). 비우면 모의 결제만 동작
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=TC0ONETIME
PUBLIC_BASE_URL=https://portal.telecom.test:8443
# 관제 스택 (monitoring/compose)
# 16자 이상 임의 문자열
GRAYLOG_PASSWORD_SECRET=
# 관리자 비밀번호의 SHA-256 (README 참고)
GRAYLOG_ROOT_PASSWORD_SHA2=
# 팀 PC에서 docker inspect 로 확인한 버전으로 고정할 것
N8N_IMAGE=n8nio/n8n:1.64.0
